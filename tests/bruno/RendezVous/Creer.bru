meta {
  name: Créer RDV
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/rdvs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "praticien_id": "{{praticienId}}",
    "patient_id": "5abcdbc4-90c9-3b86-82a3-c4cf1f7377d0",
    "date_heure": "2026-02-02 10:00:00",
    "motif_visite": "Consultation Nouveau",
    "duree": 30
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("rdvId", res.body.id);
  }
}
